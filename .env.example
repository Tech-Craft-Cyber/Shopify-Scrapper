# Copy to .env and adjust. All settings are optional.

# Where the SQLite database lives (back this file up).
DB_PATH=data/app.db

# The app listens here; put Caddy/nginx in front for HTTPS.
HOST=127.0.0.1
PORT=8000

# 1 when served over HTTPS (makes the login cookie Secure).
COOKIE_SECURE=1
SESSION_DAYS=30

# Used for links in emails.
PUBLIC_URL=https://jobs.example.com

# Optional SMTP for "new roles" digests and watched-agency alerts.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=1

# Minutes to wait before retrying rate-limited agencies at the end of a run.
RETRY_DELAY_MINUTES=60
